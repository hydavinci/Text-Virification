{
  "pii_id": [
    {
      "name": "identity number ending in X",
      "text": "身份证号：11010519491231002X",
      "options": {
        "enable_security": true
      },
      "expected": [
        {
          "type": "pii_id",
          "original": "11010519491231002X",
          "position": 5,
          "end_position": 23
        }
      ]
    },
    {
      "name": "identity number ending in lowercase x",
      "text": "身份证号：11010519491231002x",
      "options": {
        "enable_security": true
      },
      "expected": [
        {
          "type": "pii_id",
          "original": "11010519491231002x",
          "position": 5,
          "end_position": 23
        }
      ]
    }
  ],
  "mixed_punct": [
