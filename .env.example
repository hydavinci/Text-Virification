APP_ENV=development
# Optional Docker build sources; leave unset to use Docker Hub.
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-slim
# NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.27-alpine
DATABASE_URL=postgresql+psycopg://text_verification:text_verification@postgres:5432/text_verification
REDIS_URL=redis://redis:6379/0
# 留空时 Celery broker 使用 REDIS_URL；AMQP 可设置为 amqp://... 并启用 publisher confirms。
CELERY_BROKER_URL=
STORAGE_ROOT=/var/lib/text-verification/jobs
JOB_RETENTION_HOURS=24
JOB_LEASE_SECONDS=1200
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:8080
# Native API connects to the renderer's loopback-only Docker port.
PREVIEW_RENDERER_URL=http://127.0.0.1:8010
# APP_ENV=production/staging/deployed 时必须设置至少 32 个 UTF-8 字节。
RECHECK_GRANT_SECRET=
RECHECK_GRANT_TTL_SECONDS=900

# 可选：OpenAI 兼容接口语义复核。留空时完全使用本地规则。
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_REVIEW=40
LLM_CONTEXT_RADIUS=50
LLM_TIMEOUT=60
LLM_JSON_MODE=0
# Optional semantic discovery requires BOTH this server permission and each request's
# enable_semantic_discovery=true (UI defaults off). Uses the configured provider above.
# Only sampled local excerpts and relevant glossary data are sent; additional cost/latency.
# Grammar/meaning suggestions are manual-only; confidence is heuristic, not calibrated.
LLM_SEMANTIC_DISCOVERY_ALLOWED=0
LLM_SEMANTIC_MAX_CHUNKS=6
LLM_SEMANTIC_CHUNK_CHARS=800
LLM_SEMANTIC_CONTEXT_CHARS=100
LLM_SEMANTIC_MAX_FINDINGS=24
LLM_SEMANTIC_MAX_TOKENS=3000
